{
  "rules": [
    {
      "id": "rule_1",
      "description": "Deep queues under high concurrency on the static scheduler starve the dispatcher and time out",
      "conditions": [
        {
          "field": "queue_depth",
          "op": ">=",
          "value": 64
        },
        {
          "field": "concurrency",
          "op": ">=",
          "value": 16
        },
        {
          "field": "scheduler",
          "op": "==",
          "value": "static"
        }
      ],
      "effect": {
        "type": "failure_multiplier",
        "target": "pass_fail",
        "value": 3.5
      },
      "error_type_bias": "timeout",
      "phase": "outcome"
    },
    {
      "id": "rule_2",
      "description": "zstd compression on high-entropy payloads with a small cache overruns the codec window and corrupts data",
      "conditions": [
        {
          "field": "compression",
          "op": "==",
          "value": "zstd"
        },
        {
          "field": "payload_entropy",
          "op": ">",
          "value": 0.8
        },
        {
          "field": "cache_size",
          "op": "==",
          "value": "small"
        }
      ],
      "effect": {
        "type": "failure_multiplier",
        "target": "pass_fail",
        "value": 4.0
      },
      "error_type_bias": "corruption",
      "phase": "outcome"
    },
    {
      "id": "rule_3",
      "description": "Turbo power mode above 75 \u00b0C trips thermal protection",
      "conditions": [
        {
          "field": "power_mode",
          "op": "==",
          "value": "turbo"
        },
        {
          "field": "temperature",
          "op": ">",
          "value": 75.0
        }
      ],
      "effect": {
        "type": "failure_multiplier",
        "target": "pass_fail",
        "value": 3.0
      },
      "error_type_bias": "thermal",
      "phase": "outcome"
    },
    {
      "id": "rule_4",
      "description": "ECC disabled while fault injection exceeds 20 % leaves bit flips uncorrected",
      "conditions": [
        {
          "field": "ecc_mode",
          "op": "==",
          "value": "off"
        },
        {
          "field": "injection_rate",
          "op": ">",
          "value": 0.2
        }
      ],
      "effect": {
        "type": "failure_multiplier",
        "target": "pass_fail",
        "value": 2.8
      },
      "error_type_bias": "ecc_uncorrectable",
      "phase": "outcome"
    },
    {
      "id": "rule_5",
      "description": "Aggressive prefetch under random access with little memory thrashes the line fill buffer and slows execution",
      "conditions": [
        {
          "field": "prefetch_depth",
          "op": ">=",
          "value": 8
        },
        {
          "field": "access_pattern",
          "op": "==",
          "value": "random"
        },
        {
          "field": "memory_size",
          "op": "<=",
          "value": 512
        }
      ],
      "effect": {
        "type": "exec_time_multiplier",
        "target": "execution_time",
        "value": 2.2
      },
      "phase": "outcome"
    },
    {
      "id": "rule_6",
      "description": "Eco power mode on large workloads clamps the clock and stretches execution time",
      "conditions": [
        {
          "field": "power_mode",
          "op": "==",
          "value": "eco"
        },
        {
          "field": "workload",
          "op": "==",
          "value": "large"
        }
      ],
      "effect": {
        "type": "exec_time_multiplier",
        "target": "execution_time",
        "value": 1.8
      },
      "phase": "outcome"
    },
    {
      "id": "rule_7",
      "description": "Long bursts into a shallow queue under high traffic overflow the ingress FIFO",
      "conditions": [
        {
          "field": "burst_length",
          "op": ">",
          "value": 200
        },
        {
          "field": "queue_depth",
          "op": "<=",
          "value": 4
        },
        {
          "field": "traffic_pattern",
          "op": "==",
          "value": "high"
        }
      ],
      "effect": {
        "type": "failure_multiplier",
        "target": "pass_fail",
        "value": 3.2
      },
      "error_type_bias": "overflow",
      "phase": "outcome"
    },
    {
      "id": "rule_8",
      "description": "High seed ranges bias the constraint solver toward strided access patterns",
      "conditions": [
        {
          "field": "random_seed",
          "op": ">=",
          "value": 90000
        }
      ],
      "effect": {
        "type": "value_bias",
        "target": "access_pattern",
        "value": "stride",
        "probability": 0.75
      },
      "phase": "sampling"
    },
    {
      "id": "rule_9",
      "description": "High concurrency drives the traffic generator into its high-rate profile",
      "conditions": [
        {
          "field": "concurrency",
          "op": ">=",
          "value": 16
        }
      ],
      "effect": {
        "type": "value_bias",
        "target": "traffic_pattern",
        "value": "high",
        "probability": 0.6
      },
      "phase": "sampling"
    },
    {
      "id": "rule_10",
      "description": "gzip compression under concurrency of 8 or more serialises on the codec and collapses throughput",
      "conditions": [
        {
          "field": "compression",
          "op": "==",
          "value": "gzip"
        },
        {
          "field": "concurrency",
          "op": ">=",
          "value": 8
        }
      ],
      "effect": {
        "type": "throughput_multiplier",
        "target": "throughput",
        "value": 0.55
      },
      "phase": "outcome"
    }
  ]
}