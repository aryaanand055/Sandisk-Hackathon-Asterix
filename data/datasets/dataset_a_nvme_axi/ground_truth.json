  "rules": [
    {
      "id": "A1",
      "description": "Back_To_Back_Program on the Adaptive cache policy overruns the write FIFO",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "test_name",
          "op": "==",
          "value": "Back_To_Back_Program"
        },
        {
          "field": "cache_policy",
          "op": "==",
          "value": "Adaptive"
        }
      ],
      "effect": "set",
      "value": 0.85,
      "error_tag": "FIFO_OVERFLOW",
      "deterministic": false,
      "observed": {
        "rows_matched": 339,
        "match_share": 0.0565,
        "fail_rate_when_fired": 0.8938,
        "fail_rate_otherwise": 0.2231,
        "lift": 4.006
      }
    },
    {
      "id": "A2",
      "description": "Test mode raises failure probability across every run",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "test_mode_enabled",
          "op": "==",
          "value": 1
        }
      ],
      "effect": "add",
      "value": 0.35,
      "error_tag": null,
      "deterministic": false,
      "observed": {
        "rows_matched": 1669,
        "match_share": 0.2782,
        "fail_rate_when_fired": 0.5015,
        "fail_rate_otherwise": 0.1683,
        "lift": 2.979
      }
    },
    {
      "id": "A3",
      "description": "Deep queues with ECC disabled surface uncorrectable bit errors",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "queue_depth",
          "op": ">=",
          "value": 32
        },
        {
          "field": "ecc_mode",
          "op": "==",
          "value": "Disabled"
        }
      ],
      "effect": "add",
      "value": 0.32,
      "error_tag": "ECC_UNCORRECTABLE",
      "deterministic": false,
      "observed": {
        "rows_matched": 245,
        "match_share": 0.0408,
        "fail_rate_when_fired": 0.551,
        "fail_rate_otherwise": 0.2487,
        "lift": 2.216
      }
    },
    {
      "id": "A4",
      "description": "Hot and undervolted NAND loses charge retention (requires joining config.csv with telemetry.csv)",
      "files": [
        "telemetry.csv"
      ],
      "conditions": [
        {
          "field": "temperature_c",
          "op": ">",
          "value": 80.0
        },
        {
          "field": "voltage_mv",
          "op": "<",
          "value": 1120.0
        }
      ],
      "effect": "add",
      "value": 0.3,
      "error_tag": "RETENTION_FAIL",
      "deterministic": false,
      "observed": {
        "rows_matched": 173,
        "match_share": 0.0288,
        "fail_rate_when_fired": 0.5838,
        "fail_rate_otherwise": 0.2514,
        "lift": 2.322
      }
    },
    {
      "id": "A5",
      "description": "Deterministic RTL bug: 4 planes + 64-beat burst + scrambler terminates the AXI burst illegally at a fixed address",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "num_planes",
          "op": "==",
          "value": 4
        },
        {
          "field": "burst_length",
          "op": "==",
          "value": 64
        },
        {
          "field": "scrambler_enable",
          "op": "==",
          "value": 1
        }
      ],
      "effect": "set",
      "value": 0.97,
      "error_tag": "PROTOCOL_VIOLATION",
      "deterministic": true,
      "observed": {
        "rows_matched": 93,
        "match_share": 0.0155,
        "fail_rate_when_fired": 1.0,
        "fail_rate_otherwise": 0.2494,
        "lift": 4.01
      }
    },
    {
      "id": "A6",
      "description": "High clock with deep prefetch starves the monitor and trips the watchdog",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "clock_freq_mhz",
          "op": ">=",
          "value": 1000
        },
        {
          "field": "prefetch_depth",
          "op": ">",
          "value": 8
        }
      ],
      "effect": "add",
      "value": 0.28,
      "error_tag": "TIMEOUT",
      "deterministic": false,
      "observed": {
        "rows_matched": 907,
        "match_share": 0.1512,
        "fail_rate_when_fired": 0.4972,
        "fail_rate_otherwise": 0.2189,
        "lift": 2.271
      }
    },
    {
      "id": "A7",
      "description": "High-entropy payloads on a wide bus with the scrambler off mismatch the scoreboard (config.csv x randomization.csv)",
      "files": [
        "config.csv",
        "randomization.csv"
      ],
      "conditions": [
        {
          "field": "payload_entropy",
          "op": ">",
          "value": 0.8
        },
        {
          "field": "scrambler_enable",
          "op": "==",
          "value": 0
        },
        {
          "field": "data_width_bits",
          "op": ">=",
          "value": 128
        }
      ],
      "effect": "add",
      "value": 0.26,
      "error_tag": "DATA_MISMATCH",
      "deterministic": false,
      "observed": {
        "rows_matched": 179,
        "match_share": 0.0298,
        "fail_rate_when_fired": 0.4581,
        "fail_rate_otherwise": 0.2549,
        "lift": 1.797
      }
    },
    {
      "id": "A8",
      "description": "Turbo power mode above 75 C trips thermal protection (telemetry.csv only - invisible without it)",
      "files": [
        "telemetry.csv"
      ],
      "conditions": [
        {
          "field": "power_mode",
          "op": "==",
          "value": "turbo"
        },
        {
          "field": "temperature_c",
          "op": ">",
          "value": 75.0
        }
      ],
      "effect": "add",
      "value": 0.25,
      "error_tag": "THERMAL_SHUTDOWN",
      "deterministic": false,
      "observed": {
        "rows_matched": 589,
        "match_share": 0.0982,
        "fail_rate_when_fired": 0.4941,
        "fail_rate_otherwise": 0.2356,
        "lift": 2.097
      }
    }
