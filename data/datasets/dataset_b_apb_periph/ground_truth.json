  "rules": [
    {
      "id": "B1",
      "description": "Static arbitration with 8+ select lines starves the low-priority master",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "arbitration_scheme",
          "op": "==",
          "value": "static"
        },
        {
          "field": "psel_count",
          "op": ">=",
          "value": 8
        }
      ],
      "effect": "set",
      "value": 0.78,
      "error_tag": "BUS_STARVATION",
      "deterministic": false,
      "observed": {
        "rows_matched": 414,
        "match_share": 0.1035,
        "fail_rate_when_fired": 0.7778,
        "fail_rate_otherwise": 0.2596,
        "lift": 2.996
      }
    },
    {
      "id": "B2",
      "description": "No parity at 921600+ baud corrupts UART frames",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "parity_mode",
          "op": "==",
          "value": "none"
        },
        {
          "field": "baud_rate",
          "op": ">=",
          "value": 921600
        }
      ],
      "effect": "add",
      "value": 0.34,
      "error_tag": "FRAMING_ERROR",
      "deterministic": false,
      "observed": {
        "rows_matched": 473,
        "match_share": 0.1182,
        "fail_rate_when_fired": 0.5518,
        "fail_rate_otherwise": 0.2813,
        "lift": 1.962
      }
    },
    {
      "id": "B3",
      "description": "DMA enabled against a shallow FIFO underruns the stream",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "dma_enable",
          "op": "==",
          "value": 1
        },
        {
          "field": "fifo_depth",
          "op": "<=",
          "value": 8
        }
      ],
      "effect": "add",
      "value": 0.3,
      "error_tag": "FIFO_UNDERRUN",
      "deterministic": false,
      "observed": {
        "rows_matched": 734,
        "match_share": 0.1835,
        "fail_rate_when_fired": 0.5041,
        "fail_rate_otherwise": 0.2704,
        "lift": 1.864
      }
    },
    {
      "id": "B4",
      "description": "Edge-triggered interrupts on a slow clock drop events",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "irq_mode",
          "op": "==",
          "value": "edge"
        },
        {
          "field": "clk_mhz",
          "op": "<=",
          "value": 50
        }
      ],
      "effect": "add",
      "value": 0.22,
      "error_tag": "IRQ_LOST",
      "deterministic": false,
      "observed": {
        "rows_matched": 886,
        "match_share": 0.2215,
        "fail_rate_when_fired": 0.4842,
        "fail_rate_otherwise": 0.2646,
        "lift": 1.83
      }
    },
    {
      "id": "B5",
      "description": "Deterministic RTL bug: APB3 with 4+ wait states and no retry hangs the PSLVERR handshake",
      "files": [
        "config.csv"
      ],
      "conditions": [
        {
          "field": "bus_protocol",
          "op": "==",
          "value": "APB3"
        },
        {
          "field": "wait_state_cfg",
          "op": ">=",
          "value": 4
        },
        {
          "field": "retry_limit",
          "op": "==",
          "value": 0
        }
      ],
      "effect": "set",
      "value": 0.95,
      "error_tag": "PSLVERR_TIMEOUT",
      "deterministic": true,
      "observed": {
        "rows_matched": 264,
        "match_share": 0.066,
        "fail_rate_when_fired": 0.9508,
        "fail_rate_otherwise": 0.2682,
        "lift": 3.545
      }
    },
    {
      "id": "B6",
      "description": "Undervoltage above 70 C makes the CDC synchroniser metastable (telemetry.csv only)",
      "files": [
        "telemetry.csv"
      ],
      "conditions": [
        {
          "field": "voltage_mv",
          "op": "<",
          "value": 1090.0
        },
        {
          "field": "temperature_c",
          "op": ">",
          "value": 65.0
        }
      ],
      "effect": "add",
      "value": 0.2,
      "error_tag": "METASTABILITY",
      "deterministic": false,
      "observed": {
        "rows_matched": 215,
        "match_share": 0.0537,
        "fail_rate_when_fired": 0.5116,
        "fail_rate_otherwise": 0.302,
        "lift": 1.694
      }
    },
    {
      "id": "B7",
      "description": "Hotspot burst traffic with long randomized wait states stalls PREADY (randomization.csv x config.csv)",
      "files": [
        "randomization.csv"
      ],
      "conditions": [
        {
          "field": "rand_traffic_pattern",
          "op": "==",
          "value": "burst_hotspot"
        },
        {
          "field": "rand_wait_states",
          "op": ">=",
          "value": 6
        }
      ],
      "effect": "add",
      "value": 0.25,
      "error_tag": "PREADY_TIMEOUT",
      "deterministic": false,
      "observed": {
        "rows_matched": 560,
        "match_share": 0.14,
        "fail_rate_when_fired": 0.4982,
        "fail_rate_otherwise": 0.2831,
        "lift": 1.76
      }
    }
  ],
